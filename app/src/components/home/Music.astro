---
import { Image } from 'astro:assets';
import artwork from '../../assets/images/still-moving.png';
import { featuredRelease } from '../../data/releases';
import CompactPlatformLinks from '../CompactPlatformLinks.astro';
---

<section id="music" class="music">
  <div class="music-inner">

    <div class="artwork">
      <Image
        src={artwork}
        alt={`Cover of ${featuredRelease.title} by ${featuredRelease.artist}`}
        widths={[480, 720, 960]}
        sizes="(max-width: 800px) 82vw, 520px"
        format="webp"
        quality={92}
        loading="lazy"
      />
    </div>

    <div class="release">
      <p class="eyebrow">ALBUM</p>

      <h2>{featuredRelease.title}</h2>

      <p class="artist">{featuredRelease.artist}</p>

      <p class="purchase-label listen-label">LISTEN ON</p>

      <CompactPlatformLinks
        linkType="album"
        links={[
          { name: 'spotify', label: 'SPOTIFY', url: featuredRelease.albumLinks.spotify },
          { name: 'apple_music', label: 'APPLE MUSIC', url: featuredRelease.albumLinks.appleMusic },
          { name: 'amazon_music', label: 'AMAZON MUSIC', url: featuredRelease.albumLinks.amazonMusic },
          { name: 'youtube_music', label: 'YOUTUBE MUSIC', url: featuredRelease.albumLinks.youtube },
          { name: 'deezer', label: 'DEEZER', url: featuredRelease.albumLinks.deezer },
          { name: 'tidal', label: 'TIDAL', url: featuredRelease.albumLinks.tidal },
          { name: 'qobuz', label: 'QOBUZ', url: featuredRelease.albumLinks.qobuz },
        ]}
      />

      <div class="purchase">
        <p class="purchase-label">BUY / DOWNLOAD</p>

        <div class="purchase-links">
          <a
            href={featuredRelease.purchaseLinks.itunes}
            data-purchase-platform="itunes"
            data-purchase-link-type="album"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>iTunes Store</span>

            <span class="arrow" aria-hidden="true">↗</span>
          </a>

          <a
            href={featuredRelease.purchaseLinks.amazon}
            data-purchase-platform="amazon"
            data-purchase-link-type="album"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Amazon</span>

            <span class="arrow" aria-hidden="true">↗</span>
          </a>

          <a
            href={featuredRelease.purchaseLinks.qobuz}
            data-purchase-platform="qobuz"
            data-purchase-link-type="album"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Qobuz</span>

            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .music {
    background: #050505;
    color: #fff;
    padding: 150px 44px;
  }

  .music-inner {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(300px, 520px) 1fr;
    gap: clamp(70px, 10vw, 150px);
    align-items: center;
  }

  .artwork :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .release {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: #d71920;
    font-size: 10px;
    letter-spacing: .3em;
  }

  h2 {
    margin: 0;
    font-size: clamp(32px, 3.2vw, 50px);
    line-height: 1;
    font-weight: 300;
    letter-spacing: .1em;
    white-space: nowrap;
  }

  .artist {
    margin: 18px 0 0;
    color: rgba(255,255,255,.52);
    font-size: 11px;
    letter-spacing: .28em;
  }

  .listen-label {
    margin-top: 65px;
    margin-bottom: 20px;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 25px;
    margin-top: 0;
  }

  .platforms a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: rgba(255,255,255,.58);
    text-decoration: none;
    font-size: 9px;
    letter-spacing: .16em;
    white-space: nowrap;
    transition: color .2s ease, transform .2s ease;
  }

  .platforms svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .platforms .arrow {
    margin-left: -3px;
    font-size: 10px;
    opacity: .55;
  }

  .platforms a:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .purchase {
    margin-top: 40px;
  }

  .purchase-label {
    margin: 0 0 20px;
    color: #d71920;
    font-size: 9px;
    letter-spacing: .28em;
  }

  .purchase-links {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }

  .purchase-links a {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: rgba(255,255,255,.85);
    text-decoration: none;
    font-size: 10px;
    letter-spacing: .12em;
    transition: color .2s ease;
  }


  .purchase-links .arrow {
    font-size: 10px;
    opacity: .55;
  }

  .purchase-links a:hover {
    color: #fff;
  }

  @media (max-width: 800px) {
    .music {
      padding: 90px 20px 65px;
    }

    .music-inner {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .artwork {
      width: min(100%, 520px);
      margin: 0 auto;
    }

    h2 {
      font-size: clamp(32px, 10vw, 48px);
      white-space: normal;
    }

    .listen-label {
      margin-top: 35px;
    }

    .platforms {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 12px;
    }

    .platforms a {
      min-height: 32px;
      font-size: 10px;
    }

    .platforms svg {
      width: 22px;
      height: 22px;
    }
  }
</style>
