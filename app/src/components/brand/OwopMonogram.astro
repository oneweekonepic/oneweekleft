---
import monogramSvg from '../../assets/brand/owop-monogram.svg?raw';

const { class: className = '' } = Astro.props;
---

<span
  class:list={['owop-monogram inline-flex shrink-0', className]}
  aria-hidden="true"
  set:html={monogramSvg}
/>

<style>
  .owop-monogram :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
