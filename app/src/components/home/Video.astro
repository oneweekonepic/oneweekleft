---
import CompactPlatformLinks from '../CompactPlatformLinks.astro';
import { featuredRelease } from '../../data/releases';
---
<section class="video-section" aria-labelledby="video-title">
  <div class="video-inner">
    <div class="video-heading">
      <p class="eyebrow">VIDEO</p>
      <h2 id="video-title">THE WAY YOU MOVE</h2>

      <div class="single-links">
        <p>LISTEN ON</p>
        <CompactPlatformLinks
          linkType="single"
          links={[
            { name: 'spotify', label: 'SPOTIFY', url: featuredRelease.featuredSingle.links.spotify },
            { name: 'apple_music', label: 'APPLE MUSIC', url: featuredRelease.featuredSingle.links.appleMusic },
            { name: 'amazon_music', label: 'AMAZON MUSIC', url: featuredRelease.featuredSingle.links.amazonMusic },
            { name: 'youtube_music', label: 'YOUTUBE MUSIC', url: featuredRelease.featuredSingle.links.youtubeMusic },
            { name: 'deezer', label: 'DEEZER', url: featuredRelease.featuredSingle.links.deezer },
            { name: 'tidal', label: 'TIDAL', url: featuredRelease.featuredSingle.links.tidal },
            { name: 'qobuz', label: 'QOBUZ', url: featuredRelease.featuredSingle.links.qobuz },
          ]}
        />

        <div class="single-purchase">
          <p>BUY / DOWNLOAD</p>
          <div class="single-platforms">
            <a
              href="https://music.apple.com/ch/album/the-way-you-move/6813745870?app=itunes"
              data-purchase-platform="itunes"
              data-purchase-link-type="single"
              target="_blank"
              rel="noopener noreferrer"
            >iTunes Store ↗</a>
            <a
              href="https://www.amazon.com/dp/B0HK9R1G5R"
              data-purchase-platform="amazon"
              data-purchase-link-type="single"
              target="_blank"
              rel="noopener noreferrer"
            >Amazon ↗</a>
            <a
              href="https://www.qobuz.com/gb-en/album/the-way-you-move-one-week-left/nw3pfghwsqnym"
              data-purchase-platform="qobuz"
              data-purchase-link-type="single"
              target="_blank"
              rel="noopener noreferrer"
            >Qobuz ↗</a>
          </div>
        </div>
      </div>
    </div>

    <div class="video-frame">
      <video
        src="/videos/the-way-you-move.mp4"
        poster="/images/the-way-you-move-poster.jpg"
        controls
        playsinline
        preload="metadata"
        aria-label="THE WAY YOU MOVE by ONE WEEK LEFT"
      ></video>
      <a
        class="full-video-link"
        href="https://youtu.be/sEtLm78131s"
        target="_blank"
        rel="noopener noreferrer"
      >
        WATCH FULL VIDEO ON YOUTUBE <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .video-section {
    background: #050505;
    color: #fff;
    padding: 70px 44px 150px;
  }

  .video-inner {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, .65fr) 1.35fr;
    gap: clamp(50px, 8vw, 130px);
    align-items: start;
  }

  .video-heading {
    padding-top: 7px;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: #d71920;
    font-size: 10px;
    letter-spacing: .3em;
  }

  h2 {
    margin: 0;
    max-width: 320px;
    font-size: clamp(26px, 2.4vw, 38px);
    line-height: 1.15;
    font-weight: 300;
    letter-spacing: .1em;
  }

  .single-links {
    margin-top: 42px;
  }

  .single-links p {
    margin: 0 0 20px;
    color: #d71920;
    font-size: 9px;
    letter-spacing: .28em;
  }

  .single-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .single-platforms a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,.75);
    font-size: 10px;
    letter-spacing: .14em;
    text-decoration: none;
    transition: color .2s ease;
  }

  .single-platforms a:hover {
    color: #fff;
  }
  .single-links > .single-platforms svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .single-links > .single-platforms .arrow {
    opacity: .55;
  }


  .single-purchase {
    margin-top: 34px;
  }

  .single-purchase p {
    color: #d71920;
  }

  .single-purchase .single-platforms a {
    color: rgba(255,255,255,.85);
  }


  .single-links .single-platforms a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .single-links .single-platforms a svg {
    display: block;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    fill: currentColor;
  }

  .video-frame {
    width: min(380px, 100%);
    margin: 0 auto;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    background: #000;
  }

  @media (max-width: 800px) {
    .video-section {
      padding: 65px 20px 65px;
    }

    .video-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    h2 {
      font-size: clamp(28px, 9vw, 38px);
    }

    .video-frame {
      width: min(82vw, 380px);
    }
  }

.video-frame .full-video-link {
  display: block;
  margin-top: 24px;
  color: rgba(255,255,255,.75);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: .14em;
  line-height: 1.6;
  text-decoration: none;
  text-align: center;
  transition: color .2s ease;
}
.full-video-link:hover {
  color: #fff;
}
.full-video-link span {
  margin-left: 5px;
  opacity: .65;
}
</style>
