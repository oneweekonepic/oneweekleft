---
import { Image } from 'astro:assets';
import artwork from '../../assets/images/still-moving.png';
import { featuredRelease } from '../../data/releases';
---

<section id="music" class="music">
  <div class="music-inner">

    <div class="artwork">
      <Image
        src={artwork}
        alt={`Cover of ${featuredRelease.title} by ${featuredRelease.artist}`}
        widths={[480, 720, 960]}
        sizes="(max-width: 800px) 82vw, 520px"
        format="webp"
        quality={92}
        loading="lazy"
      />
    </div>

    <div class="release">
      <p class="eyebrow">ALBUM</p>

      <h2>{featuredRelease.title}</h2>

      <p class="artist">{featuredRelease.artist}</p>

      <div class="platforms">
        {featuredRelease.links.spotify && (
          <a
            href={featuredRelease.links.spotify}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Listen to ONE WEEK LEFT on Spotify"
            title="Spotify"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.488 17.308a.747.747 0 0 1-1.028.247c-2.817-1.722-6.365-2.111-10.542-1.157a.748.748 0 1 1-.333-1.458c4.57-1.045 8.492-.595 11.656 1.338a.747.747 0 0 1 .247 1.03zm1.469-3.267a.936.936 0 0 1-1.287.308c-3.225-1.982-8.142-2.556-11.958-1.398a.936.936 0 1 1-.543-1.79c4.365-1.324 9.783-.683 13.48 1.589a.936.936 0 0 1 .308 1.291zm.126-3.403C15.216 8.341 8.837 8.13 5.145 9.25a1.123 1.123 0 1 1-.651-2.149c4.239-1.285 11.285-1.037 15.735 1.603a1.123 1.123 0 0 1-1.146 1.934z"/>
            </svg>
            <span>SPOTIFY</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}

        {featuredRelease.links.appleMusic && (
          <a
            href={featuredRelease.links.appleMusic}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Listen to ONE WEEK LEFT on Apple Music"
            title="Apple Music"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21.5 3.2 9 5.7v10.1a3.5 3.5 0 1 0 1.5 2.9V9l9.5-1.9v6.7a3.5 3.5 0 1 0 1.5 2.9V3.2z"/>
            </svg>
            <span>APPLE MUSIC</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}

        {featuredRelease.links.youtube && (
          <a
            href={featuredRelease.links.youtube}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Listen to ONE WEEK LEFT on YouTube"
            title="YouTube"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>YOUTUBE</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>

  </div>
</section>

<style>
  .music {
    background: #050505;
    color: #fff;
    padding: 150px 44px;
  }

  .music-inner {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(300px, 520px) 1fr;
    gap: clamp(70px, 10vw, 150px);
    align-items: center;
  }

  .artwork :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .release {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: #d71920;
    font-size: 10px;
    letter-spacing: .3em;
  }

  h2 {
    margin: 0;
    font-size: clamp(32px, 3.2vw, 50px);
    line-height: 1;
    font-weight: 300;
    letter-spacing: .1em;
    white-space: nowrap;
  }

  .artist {
    margin: 18px 0 0;
    color: rgba(255,255,255,.52);
    font-size: 11px;
    letter-spacing: .28em;
  }

  .platforms {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-top: 50px;
  }

  .platforms a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: rgba(255,255,255,.58);
    text-decoration: none;
    font-size: 9px;
    letter-spacing: .16em;
    white-space: nowrap;
    transition: color .2s ease, transform .2s ease;
  }

  .platforms svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .platforms .arrow {
    margin-left: -3px;
    font-size: 10px;
    opacity: .55;
  }

  .platforms a:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  @media (max-width: 800px) {
    .music {
      padding: 90px 20px 65px;
    }

    .music-inner {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .artwork {
      width: min(100%, 520px);
      margin: 0 auto;
    }

    h2 {
      font-size: clamp(32px, 10vw, 48px);
      white-space: normal;
    }

    .platforms {
      margin-top: 35px;
    }
  }
</style>
