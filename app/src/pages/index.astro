---
import '../styles/global.css';
import Hero from '../components/home/Hero.astro';
import Music from '../components/home/Music.astro';
import Video from '../components/home/Video.astro';
import About from '../components/home/About.astro';
import Footer from '../components/Footer.astro';
import { featuredRelease } from '../data/releases';

const title = 'ONE WEEK LEFT — Official Site | Blues-Rock Music';
const description =
  'Official site of ONE WEEK LEFT, an AI-assisted blues-rock music project. Discover STILL MOVING, videos and official streaming links.';
const canonical = 'https://oneweekleft.music/';
const socialImage = 'https://oneweekleft.music/images/still-moving.png';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://oneweekleft.music/#website',
      url: canonical,
      name: 'ONE WEEK LEFT',
      about: {
        '@id': 'https://oneweekleft.music/#artist',
      },
    },
    {
      '@type': 'MusicGroup',
      '@id': 'https://oneweekleft.music/#artist',
      name: 'ONE WEEK LEFT',
      url: canonical,
      description: 'AI-assisted blues-rock music project.',
      genre: ['Blues rock', 'Rock'],
      sameAs: [
        featuredRelease.links.spotify,
        featuredRelease.links.appleMusic,
        featuredRelease.links.youtube,
        featuredRelease.links.amazonMusic,
        featuredRelease.links.tidal,
        featuredRelease.links.deezer,
        'https://www.instagram.com/oneweekleft.music/',
      ],
    },
    {
      '@type': 'MusicAlbum',
      '@id': 'https://oneweekleft.music/#still-moving',
      name: 'STILL MOVING',
      byArtist: {
        '@id': 'https://oneweekleft.music/#artist',
      },
      image: socialImage,
      sameAs: [
        featuredRelease.albumLinks.spotify,
        featuredRelease.albumLinks.appleMusic,
        featuredRelease.albumLinks.youtube,
        featuredRelease.albumLinks.amazonMusic,
        featuredRelease.albumLinks.tidal,
        featuredRelease.purchaseLinks.qobuz,
      ],
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ONE WEEK LEFT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="STILL MOVING by ONE WEEK LEFT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
  </head>

  <body>
    <Hero />
    <Music />
    <Video />
    <About />
    <Footer />

    <script>
      const UTM_KEYS = [
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_content',
      ];

      const params = new URLSearchParams(window.location.search);

      for (const key of UTM_KEYS) {
        const value = params.get(key);

        if (value) {
          sessionStorage.setItem(`owl_${key}`, value);
        }
      }

      const getDevice = () => {
        const ua = navigator.userAgent;

        if (/iPad|Tablet/i.test(ua)) return 'tablet';
        if (/Mobi|Android|iPhone/i.test(ua)) return 'mobile';

        return 'desktop';
      };

      document.addEventListener('click', (event) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        const link = target.closest(
          '[data-streaming-platform], [data-purchase-platform]',
        );

        if (!(link instanceof HTMLAnchorElement)) return;

        const isPurchase = Boolean(link.dataset.purchasePlatform);

        const payload = {
          event: isPurchase ? 'purchase_click' : 'streaming_click',
          platform:
            link.dataset.purchasePlatform ||
            link.dataset.streamingPlatform ||
            '',
          link_type:
            link.dataset.purchaseLinkType ||
            link.dataset.streamingLinkType ||
            '',
          language: document.documentElement.lang || '',
          device: getDevice(),
          utm_source: sessionStorage.getItem('owl_utm_source') || '',
          utm_medium: sessionStorage.getItem('owl_utm_medium') || '',
          utm_campaign: sessionStorage.getItem('owl_utm_campaign') || '',
          utm_content: sessionStorage.getItem('owl_utm_content') || '',
        };

        navigator.sendBeacon(
          '/api/streaming-click',
          new Blob([JSON.stringify(payload)], {
            type: 'application/json',
          }),
        );
      });
    </script>
  </body>
</html>
