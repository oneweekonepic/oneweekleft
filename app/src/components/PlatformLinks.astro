---
import { featuredRelease } from '../data/releases';
---

<div class="platform-links">
  <div class="platform-primary">

      <a
        href={featuredRelease.featuredSingle.links.spotify}
        data-streaming-platform="spotify"
        data-streaming-link-type="single"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Listen to THE WAY YOU MOVE on SPOTIFY"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.488 17.308a.747.747 0 0 1-1.028.247c-2.817-1.722-6.365-2.111-10.542-1.157a.748.748 0 1 1-.333-1.458c4.57-1.045 8.492-.595 11.656 1.338a.747.747 0 0 1 .247 1.03zm1.469-3.267a.936.936 0 0 1-1.287.308c-3.225-1.982-8.142-2.556-11.958-1.398a.936.936 0 1 1-.543-1.79c4.365-1.324 9.783-.683 13.48 1.589a.936.936 0 0 1 .308 1.291zm.126-3.403C15.216 8.341 8.837 8.13 5.145 9.25a1.123 1.123 0 1 1-.651-2.149c4.239-1.285 11.285-1.037 15.735 1.603a1.123 1.123 0 0 1-1.146 1.934z"/>
            </svg>
        <span class="platform-name">SPOTIFY</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a
        href={featuredRelease.featuredSingle.links.appleMusic}
        data-streaming-platform="apple_music"
        data-streaming-link-type="single"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Listen to THE WAY YOU MOVE on APPLE MUSIC"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21.5 3.2 9 5.7v10.1a3.5 3.5 0 1 0 1.5 2.9V9l9.5-1.9v6.7a3.5 3.5 0 1 0 1.5 2.9V3.2z"/>
            </svg>
        <span class="platform-name">APPLE MUSIC</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a
        href={featuredRelease.featuredSingle.links.amazonMusic}
        data-streaming-platform="amazon_music"
        data-streaming-link-type="single"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Listen to THE WAY YOU MOVE on AMAZON MUSIC"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15.93 17.09c-.38-.48-.8-.88-.8-1.79V9.26c0-2.56.18-4.91-3.41-4.91-1.42 0-3 .53-3.6 1.67-.52 1-.45 2.31-.45 2.31l3.13.34s-.04-1.28.18-1.79c.24-.56.71-.9 1.34-.9 1.76 0 1.67 1.42 1.67 2.52v.45c-2.36.27-5.44.44-6.88 1.92-1.14 1.17-1.47 2.82-1.47 4.23 0 2.71 1.71 4.07 3.9 4.07 1.85 0 2.86-.44 4.29-1.89.47.68.63 1.01 1.5 1.73.2.11.46.1.64-.06.54-.48 1.52-1.33 2.07-1.8.22-.18.18-.47.01-.71-.47-.65-.97-1.18-.97-2.39V10c0-1.7.12-3.26-1.13-4.43"/>
              <path d="M20.9 20.15C18.48 21.94 14.97 22.9 11.95 22.9c-4.24 0-8.06-1.57-10.95-4.18-.23-.21-.02-.5.25-.34 3.12 1.82 6.98 2.91 10.96 2.91 2.68 0 5.63-.56 8.34-1.7.41-.17.75.27.35.56z"/>
              <path d="M21.91 18.99c-.31-.4-2.05-.19-2.83-.09-.24.03-.27-.18-.06-.33 1.39-.98 3.66-.7 3.92-.37.27.33-.07 2.6-1.37 3.69-.2.17-.39.08-.3-.14.29-.73.95-2.36.64-2.76z"/>
            </svg>
        <span class="platform-name">AMAZON MUSIC</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a
        href={featuredRelease.featuredSingle.links.youtubeMusic}
        data-streaming-platform="youtube_music"
        data-streaming-link-type="single"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Listen to THE WAY YOU MOVE on YOUTUBE MUSIC"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
        <span class="platform-name">YOUTUBE MUSIC</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
  </div>

  <details class="platform-more">
    <summary>ALL PLATFORMS <svg class="more-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
    <div class="platform-secondary">

      <a
        href={featuredRelease.featuredSingle.links.deezer}
        data-streaming-platform="deezer"
        data-streaming-link-type="single"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Listen to THE WAY YOU MOVE on DEEZER"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2 17h4v3H2v-3zm0-4h4v3H2v-3zm5 4h4v3H7v-3zm0-4h4v3H7v-3zm0-4h4v3H7V9zm5 8h4v3h-4v-3zm0-4h4v3h-4v-3zm0-4h4v3h-4V9zm5 8h5v3h-5v-3zm0-4h5v3h-5v-3z"/>
            </svg>
        <span class="platform-name">DEEZER</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a
        href={featuredRelease.featuredSingle.links.tidal}
        data-streaming-platform="tidal"
        data-streaming-link-type="single"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Listen to THE WAY YOU MOVE on TIDAL"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 3 9 6 6 9 3 6 6 3zm6 0 3 3-3 3-3-3 3-3zm6 0 3 3-3 3-3-3 3-3zM9 6l3 3-3 3-3-3 3-3zm6 0 3 3-3 3-3-3 3-3zm-3 3 3 3-3 3-3-3 3-3zm0 6 3 3-3 3-3-3 3-3z"/>
            </svg>
        <span class="platform-name">TIDAL</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a
        href={featuredRelease.featuredSingle.links.qobuz}
        data-streaming-platform="qobuz"
        data-streaming-link-type="single"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Listen to THE WAY YOU MOVE on QOBUZ"
      >
        <img class="qobuz-logo" src="/logos/qobuz.svg" alt="" aria-hidden="true" width="22" height="22" style="width:22px;height:22px;flex:0 0 22px;object-fit:contain;" />
        <span class="platform-name">QOBUZ</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </details>
</div>

<style>
  .platform-links {
    width: min(520px, 100%);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .platform-primary,
  .platform-secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .platform-links a {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 48px;
    padding: 0 15px;
    box-sizing: border-box;
    background: #242424;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 5px;
    color: rgba(255,255,255,.92);
    text-decoration: none;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .10em;
    transition: background .2s ease, border-color .2s ease;
  }

  .platform-links a:hover,
  .platform-links a:focus-visible {
    background: #303030;
    border-color: rgba(255,255,255,.35);
  }

  .platform-links a svg {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    fill: currentColor;
  }

  .qobuz-logo {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    object-fit: contain;
  }

  .platform-name {
    white-space: nowrap;
  }

  .arrow {
    margin-left: auto;
    opacity: .55;
  }

  .platform-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    font-size: 18px;
    font-weight: 600;
  }

  .platform-more {
    text-align: center;
  }

  .platform-more summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    color: rgba(255,255,255,.65);
    font-size: 10px;
    letter-spacing: .16em;
    cursor: pointer;
    list-style: none;
  }

  .platform-more summary::-webkit-details-marker {
    display: none;
  }

  .platform-more summary .more-chevron {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: transform .2s ease;
  }

  .platform-more[open] summary .more-chevron {
    transform: rotate(180deg);
  }

  .platform-secondary {
    margin-top: 12px;
  }

  @media (max-width: 700px) {
    .platform-links {
      width: 100%;
      max-width: 380px;
      margin: 0 auto;
    }

    .platform-primary,
    .platform-secondary {
      grid-template-columns: 1fr;
      gap: 9px;
    }

    .platform-links a {
      min-height: 48px;
      font-size: 11px;
    }
  }
</style>
