---
import { Image } from 'astro:assets';
import artwork from '../../assets/images/still-moving.png';
import { featuredRelease } from '../../data/releases';
---

<section id="music" class="music">
  <div class="music-inner">

    <div class="artwork">
      <Image
        src={artwork}
        alt={`Cover of ${featuredRelease.title} by ${featuredRelease.artist}`}
        widths={[480, 720, 960]}
        sizes="(max-width: 800px) 82vw, 520px"
        format="webp"
        quality={92}
        loading="lazy"
      />
    </div>

    <div class="release">
      <p class="eyebrow">ALBUM</p>

      <h2>{featuredRelease.title}</h2>

      <p class="artist">{featuredRelease.artist}</p>

      <div class="platforms">
        {featuredRelease.albumLinks.spotify && (
          <a
            href={featuredRelease.albumLinks.spotify}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Listen to ONE WEEK LEFT on Spotify"
            title="Spotify"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.488 17.308a.747.747 0 0 1-1.028.247c-2.817-1.722-6.365-2.111-10.542-1.157a.748.748 0 1 1-.333-1.458c4.57-1.045 8.492-.595 11.656 1.338a.747.747 0 0 1 .247 1.03zm1.469-3.267a.936.936 0 0 1-1.287.308c-3.225-1.982-8.142-2.556-11.958-1.398a.936.936 0 1 1-.543-1.79c4.365-1.324 9.783-.683 13.48 1.589a.936.936 0 0 1 .308 1.291zm.126-3.403C15.216 8.341 8.837 8.13 5.145 9.25a1.123 1.123 0 1 1-.651-2.149c4.239-1.285 11.285-1.037 15.735 1.603a1.123 1.123 0 0 1-1.146 1.934z"/>
            </svg>
            <span>SPOTIFY</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}


        {featuredRelease.albumLinks.youtube && (
          <a
            href={featuredRelease.albumLinks.youtube}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Listen to ONE WEEK LEFT on YouTube"
            title="YouTube"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>YOUTUBE</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}

        {featuredRelease.albumLinks.amazonMusic && (
          <a
            href={featuredRelease.albumLinks.amazonMusic}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Listen to ONE WEEK LEFT on Amazon Music"
            title="Amazon Music"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15.93 17.09c-.38-.48-.8-.88-.8-1.79V9.26c0-2.56.18-4.91-3.41-4.91-1.42 0-3 .53-3.6 1.67-.52 1-.45 2.31-.45 2.31l3.13.34s-.04-1.28.18-1.79c.24-.56.71-.9 1.34-.9 1.76 0 1.67 1.42 1.67 2.52v.45c-2.36.27-5.44.44-6.88 1.92-1.14 1.17-1.47 2.82-1.47 4.23 0 2.71 1.71 4.07 3.9 4.07 1.85 0 2.86-.44 4.29-1.89.47.68.63 1.01 1.5 1.73.2.11.46.1.64-.06.54-.48 1.52-1.33 2.07-1.8.22-.18.18-.47.01-.71-.47-.65-.97-1.18-.97-2.39V10c0-1.7.12-3.26-1.13-4.43"/>
              <path d="M20.9 20.15C18.48 21.94 14.97 22.9 11.95 22.9c-4.24 0-8.06-1.57-10.95-4.18-.23-.21-.02-.5.25-.34 3.12 1.82 6.98 2.91 10.96 2.91 2.68 0 5.63-.56 8.34-1.7.41-.17.75.27.35.56z"/>
              <path d="M21.91 18.99c-.31-.4-2.05-.19-2.83-.09-.24.03-.27-.18-.06-.33 1.39-.98 3.66-.7 3.92-.37.27.33-.07 2.6-1.37 3.69-.2.17-.39.08-.3-.14.29-.73.95-2.36.64-2.76z"/>
            </svg>
            <span>AMAZON MUSIC</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}

        {featuredRelease.albumLinks.tidal && (
          <a
            href={featuredRelease.albumLinks.tidal}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Listen to ONE WEEK LEFT on TIDAL"
            title="TIDAL"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 3 9 6 6 9 3 6 6 3zm6 0 3 3-3 3-3-3 3-3zm6 0 3 3-3 3-3-3 3-3zM9 6l3 3-3 3-3-3 3-3zm6 0 3 3-3 3-3-3 3-3zm-3 3 3 3-3 3-3-3 3-3zm0 6 3 3-3 3-3-3 3-3z"/>
            </svg>
            <span>TIDAL</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}

      </div>
    </div>

  </div>
</section>

<style>
  .music {
    background: #050505;
    color: #fff;
    padding: 150px 44px;
  }

  .music-inner {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(300px, 520px) 1fr;
    gap: clamp(70px, 10vw, 150px);
    align-items: center;
  }

  .artwork :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .release {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: #d71920;
    font-size: 10px;
    letter-spacing: .3em;
  }

  h2 {
    margin: 0;
    font-size: clamp(32px, 3.2vw, 50px);
    line-height: 1;
    font-weight: 300;
    letter-spacing: .1em;
    white-space: nowrap;
  }

  .artist {
    margin: 18px 0 0;
    color: rgba(255,255,255,.52);
    font-size: 11px;
    letter-spacing: .28em;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 25px;
    margin-top: 50px;
  }

  .platforms a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: rgba(255,255,255,.58);
    text-decoration: none;
    font-size: 9px;
    letter-spacing: .16em;
    white-space: nowrap;
    transition: color .2s ease, transform .2s ease;
  }

  .platforms svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .platforms .arrow {
    margin-left: -3px;
    font-size: 10px;
    opacity: .55;
  }

  .platforms a:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  @media (max-width: 800px) {
    .music {
      padding: 90px 20px 65px;
    }

    .music-inner {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .artwork {
      width: min(100%, 520px);
      margin: 0 auto;
    }

    h2 {
      font-size: clamp(32px, 10vw, 48px);
      white-space: normal;
    }

    .platforms {
      margin-top: 35px;
    }
  }
</style>
