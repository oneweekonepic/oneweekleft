---
import '../styles/global.css';
import Hero from '../components/home/Hero.astro';
import Music from '../components/home/Music.astro';
import About from '../components/home/About.astro';
import Footer from '../components/Footer.astro';

const title = 'ONE WEEK LEFT — Official Website';
const description =
  'ONE WEEK LEFT is a blues-rock project built on massive organic drums, deep bass, raw guitars and a warm, low-mid voice.';
const canonical = 'https://oneweekleft.music/';
const socialImage = 'https://oneweekleft.music/images/still-moving.png';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ONE WEEK LEFT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="STILL MOVING by ONE WEEK LEFT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>

  <body>
    <Hero />
    <Music />
    <About />
    <Footer />

    <script>
      const UTM_KEYS = [
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_content',
      ];

      const params = new URLSearchParams(window.location.search);

      for (const key of UTM_KEYS) {
        const value = params.get(key);

        if (value) {
          sessionStorage.setItem(`owl_${key}`, value);
        }
      }

      const getDevice = () => {
        const ua = navigator.userAgent;

        if (/iPad|Tablet/i.test(ua)) return 'tablet';
        if (/Mobi|Android|iPhone/i.test(ua)) return 'mobile';

        return 'desktop';
      };

      document.addEventListener('click', (event) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        const link = target.closest('[data-streaming-platform]');

        if (!(link instanceof HTMLAnchorElement)) return;

        const payload = {
          platform: link.dataset.streamingPlatform || '',
          link_type: link.dataset.streamingLinkType || '',
          language: document.documentElement.lang || '',
          device: getDevice(),
          utm_source: sessionStorage.getItem('owl_utm_source') || '',
          utm_medium: sessionStorage.getItem('owl_utm_medium') || '',
          utm_campaign: sessionStorage.getItem('owl_utm_campaign') || '',
          utm_content: sessionStorage.getItem('owl_utm_content') || '',
        };

        navigator.sendBeacon(
          '/api/streaming-click',
          new Blob([JSON.stringify(payload)], {
            type: 'application/json',
          }),
        );
      });
    </script>
  </body>
</html>
